# Copy to .env and fill in from Supabase: Project Settings → API.
# Both values are public client keys (safe in the app); never put the service_role key here.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR-PUBLISHABLE-OR-ANON-KEY
# Set to "on" after adding Google as a sign-in provider in Supabase.
EXPO_PUBLIC_GOOGLE_SIGNIN=
